<?xml version="1.0"?>
<sdf version="1.6">
  <world name="obstacles_test">
    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <model name="north_wall">
      <static>true</static>
      <pose>0 4 0.5 0 0 0</pose>
      <link name="wall">
        <collision name="collision">
          <geometry><box><size>8 0.15 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 0.15 1</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="south_wall">
      <static>true</static>
      <pose>0 -4 0.5 0 0 0</pose>
      <link name="wall">
        <collision name="collision">
          <geometry><box><size>8 0.15 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 0.15 1</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="east_wall">
      <static>true</static>
      <pose>4 0 0.5 0 0 0</pose>
      <link name="wall">
        <collision name="collision">
          <geometry><box><size>0.15 8 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 8 1</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="west_wall">
      <static>true</static>
      <pose>-4 0 0.5 0 0 0</pose>
      <link name="wall">
        <collision name="collision">
          <geometry><box><size>0.15 8 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 8 1</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="obstacle_1">
      <static>true</static>
      <pose>-1.5 1 0.4 0 0 0.3</pose>
      <link name="box">
        <collision name="collision">
          <geometry><box><size>1.2 0.7 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.7 0.8</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="obstacle_2">
      <static>true</static>
      <pose>1.5 -1 0.35 0 0 -0.2</pose>
      <link name="box">
        <collision name="collision">
          <geometry><box><size>0.8 1.4 0.7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 1.4 0.7</size></box></geometry>
        </visual>
      </link>
    </model>
  </world>
</sdf>
